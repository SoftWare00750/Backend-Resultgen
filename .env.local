# ─── API ──────────────────────────────────────────────────────────────────────
# Leave this EMPTY for local development.
# next.config.js rewrites /api/* → http://localhost:4000/api/* automatically,
# so you never need to set this locally.
#
# Set it ONLY if you want the browser to call the backend directly (e.g.
# a deployed frontend calling a separately hosted backend):
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://backend-resultgen.onrender.com/api

# ─── Backend URL (used by next.config.js rewrite on the server side) ──────────
# Change this if your backend runs on a different port or host.
BACKEND_URL=http://localhost:4000/api

NODE_OPTIONS="--use-system-ca"

NODE_EXTRA_CA_CERTS="/Users/USER/AppData/Local/mkcert/rootCA.pem"