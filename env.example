# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Postgres connection (either DATABASE_URL or the discrete fields below)
DATABASE_URL=postgres://rgs_user:rgs_password@localhost:5432/rgs_db

PGHOST=localhost
PGPORT=5432
PGDATABASE=rgs_db
PGUSER=rgs_user
PGPASSWORD=rgs_password

# CORS - the URL of the Next.js frontend
CLIENT_ORIGIN=http://localhost:3000

# First admin auto-seeded on first migrate/seed run
SEED_ADMIN_EMAIL=admin@school.edu.ng
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Administrator

# ─────────────────────────────────────────────────────────────────────────
# Gmail SMTP — used to email the verification code to a prospective
# Admin/School Owner/School Proprietor during registration.
# 1. Turn on 2-Step Verification on the sending Gmail account.
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your normal password).
# If these are left blank, codes are logged to the server console instead
# of emailed — useful for local dev.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Seconds an admin must wait before requesting another verification code.
ADMIN_CODE_RESEND_COOLDOWN_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────
# Paystack — payments and financial details
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use the test keys (pk_test_/sk_test_) until you're ready to go live.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Small non-refundable-by-default charge (kobo) used to capture a reusable
# card authorization when someone starts a free trial. ₦50 = 5000.
PAYSTACK_CARD_VERIFICATION_KOBO=5000

# ─────────────────────────────────────────────────────────────────────────
# Google Sheets overflow store — when a write to Postgres fails because the
# database is out of storage, the row is written to a Google Sheet instead
# of being lost, and merged back into GET responses. The sheet lives in
# whichever Google account issued the refresh token below — for this
# project that's tdsoft01@gmail.com.
#
# One-time setup:
#   1. In Google Cloud Console, create an OAuth 2.0 Client ID of type
#      "Desktop app" (APIs & Services > Credentials) and enable the
#      Google Sheets API + Google Drive API for the project.
#   2. Copy GOOGLE_SHEETS_OAUTH_CLIENT_ID / GOOGLE_SHEETS_OAUTH_CLIENT_SECRET
#      below from that client.
#   3. Run: node scripts/get-google-sheets-token.js
#      Sign in as tdsoft01@gmail.com when the browser opens and approve
#      access. Paste the printed refresh token below.
#
# Leave these blank to disable the feature entirely (writes simply fail
# with a normal error if Postgres runs out of storage, same as before).
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_OAUTH_REFRESH_TOKEN=
# Title of the spreadsheet created in that account. Change this if you ever
# need to force a fresh spreadsheet (e.g. after manually archiving the old one).
GOOGLE_SHEETS_SPREADSHEET_TITLE=RGS Overflow Storage

# ─────────────────────────────────────────────────────────────────────────
# IMPORTANT: Do NOT set NODE_EXTRA_CA_CERTS or NODE_TLS_REJECT_UNAUTHORIZED.
# This backend always serves plain HTTP (see src/server.js) and never makes
# outbound HTTPS requests that need an extra trusted CA. The only TLS
# connection it ever makes is to Postgres, and that already sets
# `ssl: { rejectUnauthorized: false }` in src/db/pool.js for cloud-hosted
# databases (Render/Neon/Supabase etc.).
#
# A previous version of this file set NODE_EXTRA_CA_CERTS to a path that
# only existed on one developer's Windows machine
# (".../AppData/Local/mkcert/rootCA.pem"). If you copy this file to `.env`
# and that variable is present but the file doesn't exist on your machine,
# Node will emit TLS/certificate warnings for this process and can produce
# errors like: "self-signed certificate; if the root CA is installed
# locally, try running Node.js with --use-system-ca". Leave this unset.
# ─────────────────────────────────────────────────────────────────────────